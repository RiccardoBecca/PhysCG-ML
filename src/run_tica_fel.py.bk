import argparse
import os
import numpy as np
import matplotlib.pyplot as plt
from scipy.spatial.distance import pdist
from scipy.linalg import eigh

def parse_xyz_backbone_trajectory(xyz_path: str):
    """Parses XYZ trajectory and extracts coordinates for ONLY 'B' atoms per frame."""
    frames_bb = []
    steps = []
    
    with open(xyz_path, 'r') as f:
        while True:
            line = f.readline()
            if not line:
                break
            line = line.strip()
            if not line:
                continue
            
            try:
                num_atoms = int(line)
            except ValueError:
                continue
            
            header = f.readline().strip()
            step_val = len(frames_bb)
            if "Step" in header:
                parts = header.split()
                for i, p in enumerate(parts):
                    if p == "Step" and i + 1 < len(parts):
                        try:
                            step_val = int(parts[i+1])
                        except ValueError:
                            pass
            
            frame_coords = []
            for _ in range(num_atoms):
                atom_line = f.readline().split()
                if len(atom_line) >= 4:
                    name = atom_line[0].strip()
                    if name == 'B':
                        x, y, z = float(atom_line[1]), float(atom_line[2]), float(atom_line[3])
                        frame_coords.append([x, y, z])
            
            steps.append(step_val)
            frames_bb.append(np.array(frame_coords))
            
    return np.array(steps), np.array(frames_bb)

def parse_pdb_backbone(pdb_path: str):
    """Parses a PDB file and extracts coordinates for ONLY 'B' backbone atoms."""
    bb_coords = []
    with open(pdb_path, 'r') as f:
        for line in f:
            if line.startswith(('ATOM', 'HETATM')):
                atom_name = line[12:16].strip()
                if atom_name == 'B':
                    try:
                        x = float(line[30:38])
                        y = float(line[38:46])
                        z = float(line[46:54])
                        bb_coords.append([x, y, z])
                    except (ValueError, IndexError):
                        # Fallback for space-separated format
                        parts = line.split()
                        if len(parts) >= 9:
                            bb_coords.append([float(parts[6]), float(parts[7]), float(parts[8])])
    return np.array(bb_coords)

def fit_transform_tica(features: np.ndarray, lag: int = 10, n_components: int = 2):
    """
    Performs Time-lagged Independent Component Analysis (TICA).
    """
    N = len(features)
    if N <= lag:
        raise ValueError(f"Trajectory length ({N}) must be greater than lag time ({lag}).")

    # 1. Mean-center features
    mean_feat = np.mean(features, axis=0)
    X = features - mean_feat

    # 2. Time-lagged data splits
    X_0 = X[:-lag]
    X_tau = X[lag:]

    # 3. Calculate zero-lag covariance matrix C(0)
    C_0 = (X_0.T @ X_0 + X_tau.T @ X_tau) / (2.0 * (N - lag))

    # 4. Calculate time-lagged covariance matrix C(tau)
    C_tau = (X_0.T @ X_tau) / (N - lag)
    C_tau = (C_tau + C_tau.T) / 2.0  # Symmetrize

    # 5. Solve generalized eigenvalue problem: C_tau * v = lambda * C_0 * v
    C_0 += 1e-6 * np.eye(C_0.shape[0])
    eigvals, eigvecs = eigh(C_tau, C_0)

    # 6. Sort eigenvalues & eigenvectors in descending order
    idx = np.argsort(eigvals)[::-1]
    eigvals = eigvals[idx]
    eigvecs = eigvecs[:, idx]

    # Select top components
    top_vecs = eigvecs[:, :n_components]
    top_eigvals = eigvals[:n_components]

    # 7. Project full features onto TICs
    tic_projection = X @ top_vecs

    return mean_feat, top_vecs, top_eigvals, tic_projection

def apply_tica(features: np.ndarray, mean_feat: np.ndarray, top_vecs: np.ndarray):
    """Applies a previously fitted TICA model to new features."""
    return (features - mean_feat) @ top_vecs

def extract_frames_to_xyz(input_xyz: str, target_indices: list, output_xyz: str):
    """
    Reads the original XYZ file and writes out full frames matching target_indices.
    Creates missing output directories automatically.
    """
    target_indices = set(target_indices)
    current_frame = 0
    
    # Ensure output directory exists
    out_dir = os.path.dirname(output_xyz)
    if out_dir:
        os.makedirs(out_dir, exist_ok=True)
    
    with open(input_xyz, 'r') as f_in, open(output_xyz, 'w') as f_out:
        while True:
            line = f_in.readline()
            if not line:
                break
            line = line.strip()
            if not line:
                continue
                
            try:
                num_atoms = int(line)
            except ValueError:
                continue
                
            header = f_in.readline()
            atoms = [f_in.readline() for _ in range(num_atoms)]
            
            if current_frame in target_indices:
                f_out.write(f"{num_atoms}\n")
                f_out.write(header)
                for atom_line in atoms:
                    f_out.write(atom_line)
                    
            current_frame += 1

def main():
    parser = argparse.ArgumentParser(description="Compute TICA and Free Energy Landscape for CG backbone trajectory.")
    parser.add_argument("--xyz", required=True, help="Path to trajectory XYZ file")
    parser.add_argument("--lag", type=int, default=10, help="TICA lag time in frames (default: 10)")
    parser.add_argument("--bins", type=int, default=50, help="Number of bins for 2D FEL histogram (default: 50)")
    parser.add_argument("--temp", type=float, default=300.0, help="Temperature in Kelvin (default: 300.0)")
    parser.add_argument("--eq_steps", type=int, default=0, help="Number of initial simulation steps to discard as equilibration (default: 0)")
    parser.add_argument("--out", default="tica_fel.png", help="Output plot filename (default: tica_fel.png)")
    
    # TICA Save/Load Arguments
    parser.add_argument("--save_tica", help="Path to save fitted TICA model (.npz format)")
    parser.add_argument("--load_tica", help="Path to load pre-fitted TICA model (.npz format)")
    
    # Configuration Extraction Arguments
    parser.add_argument("--extract_centers", nargs="+", help="List of TIC1,TIC2 coordinates to extract configurations from (e.g., '0.5,-0.7' '0.2,1.7')")
    parser.add_argument("--samples", type=int, default=10, help="Number of configurations to extract per center (default: 10)")
    parser.add_argument("--extract_prefix", default="state", help="Prefix/path for extracted xyz filenames")
    
    # Optional Crystal Reference PDB Argument
    parser.add_argument("--crystal", help="Path to reference CG crystal structure PDB file (plots reference as a STAR)")
    
    args = parser.parse_args()

    # Ensure plot directory exists
    plot_dir = os.path.dirname(args.out)
    if plot_dir:
        os.makedirs(plot_dir, exist_ok=True)

    # 1. Load Backbone Trajectory
    print(f"Loading trajectory from: {args.xyz}")
    steps, bb_coords = parse_xyz_backbone_trajectory(args.xyz)
    total_frames = len(steps)
    
    # Filter out equilibration steps
    valid_indices = steps >= args.eq_steps
    steps = steps[valid_indices]
    bb_coords = bb_coords[valid_indices]
    
    n_frames, n_beads, _ = bb_coords.shape
    discarded = total_frames - n_frames
    
    print(f"Discarded {discarded} equilibration frames (steps < {args.eq_steps}).")
    print(f"Processing {n_frames} production frames with {n_beads} backbone 'B' beads each.")

    # 2. Compute Internal Pairwise Distance Features
    print("Computing backbone pairwise distance features...")
    feature_matrix = np.zeros((n_frames, int(n_beads * (n_beads - 1) / 2)))
    for i in range(n_frames):
        feature_matrix[i] = pdist(bb_coords[i], metric='euclidean')

    # 3. Handle TICA (Load or Fit)
    if args.load_tica:
        print(f"Loading pre-fitted TICA model from: {args.load_tica}...")
        tica_data = np.load(args.load_tica)
        mean_feat = tica_data['mean_feat']
        top_vecs = tica_data['top_vecs']
        eigenvalues = tica_data['eigvals']
        tics = apply_tica(feature_matrix, mean_feat, top_vecs)
        print("TICA projection complete.")
    else:
        if n_frames <= args.lag:
            raise ValueError(f"Not enough frames left after discarding equilibration ({n_frames}) to support lag time ({args.lag}).")
        
        print(f"Fitting TICA with lag time = {args.lag} frames...")
        mean_feat, top_vecs, eigenvalues, tics = fit_transform_tica(feature_matrix, lag=args.lag, n_components=2)
        
        if args.save_tica:
            save_dir = os.path.dirname(args.save_tica)
            if save_dir:
                os.makedirs(save_dir, exist_ok=True)
            print(f"Saving TICA model to: {args.save_tica}...")
            np.savez(args.save_tica, mean_feat=mean_feat, top_vecs=top_vecs, eigvals=eigenvalues)
            
    print(f"Top 2 TICA Eigenvalues: TIC1 = {eigenvalues[0]:.4f}, TIC2 = {eigenvalues[1]:.4f}")

    # 4. Process Optional Crystal Structure
    crystal_tic = None
    if args.crystal:
        print(f"Loading reference crystal structure from: {args.crystal}")
        crystal_bb_coords = parse_pdb_backbone(args.crystal)
        if len(crystal_bb_coords) != n_beads:
            raise ValueError(
                f"Bead count mismatch: trajectory has {n_beads} 'B' beads, "
                f"but crystal PDB has {len(crystal_bb_coords)} 'B' beads."
            )
        crystal_features = pdist(crystal_bb_coords, metric='euclidean')
        crystal_tic = apply_tica(crystal_features.reshape(1, -1), mean_feat, top_vecs)[0]
        print(f"Crystal PDB projected onto TIC space: TIC1 = {crystal_tic[0]:.4f}, TIC2 = {crystal_tic[1]:.4f}")

    # 5. Compute 2D Free Energy Landscape (FEL)
    kB = 0.0019872042  # kcal/(mol*K)
    kT = kB * args.temp

    counts, xedges, yedges = np.histogram2d(tics[:, 0], tics[:, 1], bins=args.bins, density=True)
    counts = np.maximum(counts, 1e-10)
    free_energy = -kT * np.log(counts)
    free_energy -= np.min(free_energy)
    free_energy = np.where(counts > 1e-9, free_energy, np.nan)

    xcenters = 0.5 * (xedges[:-1] + xedges[1:])
    ycenters = 0.5 * (yedges[:-1] + yedges[1:])

    # 6. Plotting
    fig, (ax1, ax2) = plt.subplots(1, 2, figsize=(14, 6))

    # Subplot 1: Trajectory Projection
    sc = ax1.scatter(tics[:, 0], tics[:, 1], c=steps, cmap='plasma', s=1, alpha=0.7)
    ax1.set_xlabel('TIC 1', fontsize=12)
    ax1.set_ylabel('TIC 2', fontsize=12)
    ax1.set_title('Production Trajectory Projection on TIC Space', fontsize=14)
    cbar1 = fig.colorbar(sc, ax=ax1)
    cbar1.set_label('Simulation Step', fontsize=11)
    ax1.grid(True, linestyle=':', alpha=0.5)

    # Subplot 2: Free Energy Landscape Contours
    X_grid, Y_grid = np.meshgrid(xcenters, ycenters)
    contour = ax2.contourf(X_grid, Y_grid, free_energy.T, levels=20, cmap='jet_r')
    ax2.set_xlabel('TIC 1', fontsize=12)
    ax2.set_ylabel('TIC 2', fontsize=12)
    ax2.set_title(f'Free Energy Landscape (kcal/mol at {args.temp}K)', fontsize=14)
    cbar2 = fig.colorbar(contour, ax=ax2)
    cbar2.set_label('Free Energy (kcal/mol)', fontsize=11)
    ax2.grid(True, linestyle=':', alpha=0.3)

    # Plot extracted center targets (X markers)
    if args.extract_centers:
        for i, center in enumerate(args.extract_centers):
            try:
                cx, cy = map(float, center.split(','))
                label = "Extracted State Center" if i == 0 else None
                ax2.scatter(cx, cy, c='red', marker='x', s=100, linewidths=2, label=label, zorder=9)
            except ValueError:
                pass

    # Plot Crystal PDB Position (STAR marker)
    if crystal_tic is not None:
        ax1.scatter(crystal_tic[0], crystal_tic[1], c='gold', marker='*', s=250, edgecolor='black', linewidth=1.2, zorder=10, label='Crystal Structure')
        ax1.legend(loc='upper right')
        
        ax2.scatter(crystal_tic[0], crystal_tic[1], c='gold', marker='*', s=250, edgecolor='black', linewidth=1.2, zorder=10, label='Crystal Structure')
        ax2.legend(loc='upper right')

    plt.tight_layout()
    plt.savefig(args.out, dpi=300)
    print(f"TICA Free Energy Landscape saved to: {args.out}\n")

    # 7. Extract Configurations
    if args.extract_centers:
        absolute_indices = np.arange(total_frames)[valid_indices]
        
        for i, center_str in enumerate(args.extract_centers):
            try:
                c1, c2 = map(float, center_str.split(','))
            except ValueError:
                print(f"Error parsing center '{center_str}'. Make sure format is X,Y (e.g. 0.5,-0.7). Skipping.")
                continue

            distances = np.linalg.norm(tics[:, :2] - np.array([c1, c2]), axis=1)
            closest_idx_in_production = np.argsort(distances)[:args.samples]
            target_absolute_indices = absolute_indices[closest_idx_in_production]
            
            out_filename = f"{args.extract_prefix}_center{i+1}.xyz"
            print(f"Extracting {args.samples} frames closest to TIC=({c1}, {c2}) -> {out_filename}")
            
            extract_frames_to_xyz(args.xyz, target_absolute_indices, out_filename)
        print("Extraction complete.")

if __name__ == "__main__":
    main()
